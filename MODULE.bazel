module(
    name = "aya",
    version = "0.0.0",
)

bazel_dep(name = "aspect_rules_lint", version = "2.7.2", dev_dependency = True)

bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# The archive_override below pins the exact linux.bzl revision.
bazel_dep(name = "linux.bzl", version = "0.0.0")

# libbpf supplies headers and libraries for the C BPF integration-test objects.
bazel_dep(name = "libbpf", version = "1.7.0")

# The LLVM toolchain compiles C BPF objects and the integration VM kernels.
bazel_dep(name = "llvm", version = "0.8.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_qemu", version = "0.3.0")
bazel_dep(name = "rules_rs", version = "0.0.107")
bazel_dep(name = "rules_shell", version = "0.8.0")

# linux.bzl derives its Kbuild compiler and link commands from these LLVM
# C++ toolchain actions. Bazel requires patches in the root module's tree.
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//bazel:llvm_kbuild_actions.patch"],
    version = "0.8.18",
)

# with_cfg.bzl selects BPF target architectures and the optimized test mode.
bazel_dep(name = "with_cfg.bzl", version = "0.14.6")

# These hermetic targets are used instead of build scripts below.
bazel_dep(name = "xz", version = "5.4.5.bcr.8")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

# //test/integration-test:bpf_out_dir uses copy_to_directory.
bazel_lib_toolchains = use_extension("@bazel_lib//lib:extensions.bzl", "toolchains")
bazel_lib_toolchains.copy_to_directory()
use_repo(bazel_lib_toolchains, "copy_to_directory_toolchains")

# Pin the linux.bzl revision with source-built images for all VM architectures.
archive_override(
    module_name = "linux.bzl",
    integrity = "sha256-Mnabs8WNq29OiveKxISmkoJIY2lKcQmDcFhCYNe0E8w=",
    strip_prefix = "linux.bzl-cc0db879f93e7b9dec270eff8af9f4fbc7b22b8f",
    urls = ["https://github.com/tamird/linux.bzl/archive/cc0db879f93e7b9dec270eff8af9f4fbc7b22b8f.tar.gz"],
)

# @rules_rs creates @rules_rust here; generated BUILD files and .bazelrc labels
# reference @rules_rust directly.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# Aya's eBPF crates use generic_const_exprs, asm_experimental_arch, and
# core_intrinsics, so the hermetic Rust toolchain must be a pinned nightly.
# CI reads these same version attributes; scripts/rust-toolchain-pins.py
# advances them with Buildozer.
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    name = "default_rust_toolchains",
    edition = "2024",
    version = "nightly/2026-09-17",
)

# Cargo CI uses stable, but Bazel's eBPF targets still require nightly. Expose
# the stable repository without registering it as a default toolchain.
toolchains.toolchain(
    name = "stable_rust_toolchains",
    edition = "2024",
    version = "1.98.1",
)
use_repo(toolchains, "default_rust_toolchains", "stable_rust_toolchains")

# Each qemu-system toolchain is compatible with the corresponding
# //bazel:bpf_target_arch value. bazel/vm.bzl transitions that value for each
# integration VM test.
qemu = use_extension("@rules_qemu//qemu/extension:qemu.bzl", "qemu")
qemu.system_toolchain(
    system_target = "aarch64-softmmu",
    target_settings = ["//bazel:bpf_target_arch_aarch64"],
)
qemu.system_toolchain(
    system_target = "x86_64-softmmu",
    target_settings = ["//bazel:bpf_target_arch_x86_64"],
)

# rules_qemu declares both repositories as root-module direct dependencies;
# Aya registers only qemu_system_toolchains below.
use_repo(qemu, "qemu_system_toolchains", "qemu_user_toolchains")

# The macOS QEMU toolchain uses the Homebrew installation from the Brewfile.
# Its local repository publishes a toolchain only on macOS.
homebrew_qemu_repository = use_repo_rule("//bazel:homebrew_qemu.bzl", "homebrew_qemu_repository")

homebrew_qemu_repository(name = "homebrew_qemu")

register_toolchains(
    "@copy_to_directory_toolchains//:all",
    "@default_rust_toolchains//...",
    "@linux.bzl//internal:busybox_script_runtime_toolchain",
    "@llvm//toolchain:all",
    "@qemu_system_toolchains//:all",
    "@homebrew_qemu//:all",
)

# Generate Cargo dependencies for every Rust execution and target platform used
# by Aya's local hosts, integration VMs, and BPF targets.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "bpfeb-unknown-none",
        "bpfel-unknown-none",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)

# Replace build scripts with hermetic targets.
crate.annotation(
    crate = "lzma-sys",
    gen_build_script = "off",
    deps = ["@xz//:lzma"],
)
crate.annotation(
    crate = "zstd-sys",
    gen_build_script = "off",
    deps = ["@zstd"],
)

# Replace libbpf-sys's build.rs with @libbpf and export the bundled vmlinux.h
# used by //test/integration-test:c_bpf_objects.
crate.annotation(
    additive_build_file_content = """
exports_files(
    ["libbpf/.github/actions/build-selftests/vmlinux.h"],
    visibility = ["//visibility:public"],
)
""",
    crate = "libbpf-sys",
    extra_aliased_targets = {
        "libbpf-sys-vmlinux-h": "libbpf/.github/actions/build-selftests/vmlinux.h",
    },
    gen_build_script = "off",
    deps = ["@libbpf"],
)
use_repo(crate, "crates")

linux_source_repository = use_repo_rule("@linux.bzl//:linux.bzl", "linux_source_repository")

linux_source_repository(
    name = "aya_linux_5_10_270",
    integrity = "sha256-3nPVKLBL6R9uuGZgqmek1TuWu/ILtaMm54+ALXRN6+c=",
    # Linux 5.10 disables Clang's integrated assembler unless requested.
    # https://github.com/gregkh/linux/blob/1797d8bf8d0c2e74defad605d14e3553d43a3caf/Makefile#L583-L586
    module_make_vars = {"LLVM_IAS": "1"},
    module_targets = {"sch_ingress": "net/sched/sch_ingress.ko"},
    strip_prefix = "linux-5.10.270",
    urls = ["https://cdn.kernel.org/pub/linux/kernel/v5.x/linux-5.10.270.tar.xz"],
    version = "5.10.270",
)

